{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>vicione-oss/tooling/renovate-orchestrator"
  ],
  "enabledManagers": [
    "gitlabci"
  ],
  "packageRules": [
    {
      "matchManagers": ["gitlabci"],
      "enabled": false
    },
    {
      "matchManagers": ["gitlabci"],
      "matchDepTypes": ["repository"],
      "enabled": true
    }
  ]
}
