<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ViciOneSuiteSdkVersion>2.1.0</ViciOneSuiteSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="ViciOne.CodeAnalysis" Version="1.6.0" />
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.100.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="5.9.3" />
    <PackageVersion Include="ViciOne.Suite.Sdk" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Backend" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Client" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Deployment" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Ui.Design" Version="2.1.0" />
    <PackageVersion Include="ViciOne.Ui.Localization" Version="3.4.0" />
    <PackageVersion Include="ViciOne.Ui.MonochromeIcons.Assets" Version="4.11.0" />    
    <!--Used for tests only:-->
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Testing" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
</Project>
