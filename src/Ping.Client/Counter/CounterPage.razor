@using Sdk.MessageBanner.Contracts;
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.ComboBox
@using ViciOne.Ui.Blazor.Components.TextBox

@inherits ModulePageBase<PingClientModule>
@attribute [Route(PingClientModule.CounterPageRoute)]

<div class="counter-page">
    <div>
        <h3>@Localization.Common.ModuleTitle</h3>

        <p>@Localization.Common.ModuleDescription</p>

        <p>
            <Button Id="decrement-button"
                    Size="@ButtonSize.Small"
                    Text="@Localization.CounterPage.DecrementCounter"
                    OnClick="@DecrementCounter" />

            <Button Id="reset-button"
                    Size="@ButtonSize.Small"
                    Text="@Localization.CounterPage.ResetCounter"
                    OnClick="@ResetCounter" />

            <Button Id="increment-button"
                    Size="@ButtonSize.Small"
                    Text="@Localization.CounterPage.IncrementCounter"
                    OnClick="@IncrementCounter" />

            <Button Size="@ButtonSize.Small"
                    Text="@Localization.CounterPage.CallJavascript"
                    OnClick="@CallIsolatedJavaScript" />
        </p>
        <p id="increment-result">
            <em>@string.Format(Localization.CounterPage.ClickedXTimesFormat, SimpleCounter.Value)</em>
        </p>
    </div>

    <div class="message-banner">
        <h4>MessageBanner</h4>
        <div class="message-banner-form">
            <label>Type: </label>
            <ComboBox TItem="ComboBoxItem<MessageType, string>"
                      TValue="MessageType"
                      Items="@_messageTypes"
                      ValueSelector="@(item => item.Value)"
                      TextSelector="@(item => item.Text)"
                      Value="@_messageType"
                      ValueChanged="@OnMessageTypeChanged" />

            <label>Description: </label>
            <TextBox Value="@_description" ValueChanged="@OnDescriptionChanged" />

            <Button Size="@ButtonSize.Small"
                    Text="@Localization.CounterPage.ShowBanner"
                    OnClick="@(() => MessageBannerService.ShowMessageBanner(_messageType, _description))" />

            <Button Size="@ButtonSize.Small"
                    Text="@Localization.CounterPage.RemoveBanner"
                    OnClick="@MessageBannerService.CloseMessageBanner" />
        </div>
    </div>

    <div class="color-area">
        <h4>Suite Color Styles</h4>
        <div class="color-box">
            <div class="background">background</div>
            <div class="background-dark">background-dark</div>
            <div class="content">content</div>
            <div class="content-dark">content-dark</div>
            <div class="content">content</div>
            <div class="content-dark">content-dark</div>
            <div class="disabled">disabled</div>
            <div class="disabled-dark">disabled-dark</div>
            <div class="accent">accent</div>
            <div class="accent-dark">accent-dark</div>
            <div class="accent-background">accent-background</div>
        </div>
    </div>

</div>
