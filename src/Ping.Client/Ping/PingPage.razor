@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components.ActionButtons
@using ViciOne.Ui.Blazor.Components.Grid.Components.Columns
@using ViciOne.Ui.Blazor.Components.SpinEdit
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.Localization.Resources

@attribute [Route(PingClientModule.PingPageRoute)]

@inherits ModulePageBase<PingClientModule>

<div class="ping-page">
    <h3>@Localization.PingPage.PingToBackend</h3>
    @* <p> *@
    @*     This component demonstrates a call to the backend and receives the answer.<br> *@
    @*     <em>Current Server time: @(_currentServerTime.ToString("G"))</em> *@
    @* </p> *@

    <div style="float: right; margin-right: 20px;">
        @if (PingState.SelectedPing == null)
        {
            <p>
                <em>@Localization.PingPage.NoPingSelected</em>
            </p>
        }
        else
        {
            <h4>@CommonVocabulary.Selected @Localization.PingPage.Ping</h4>
            <p>
                <em>@Localization.PingPage.OriginallyCreatedAt @(PingState.SelectedPing.Created.ToString("G"))</em><br>
                <em>@Localization.PingPage.Id @(PingState.SelectedPing.Id)</em><br>
                <em>@Localization.PingPage.Origin @(PingState.PingResultOrigin)</em><br>
                <em>@CommonVocabulary.Message: @(PingState.SelectedPing.Message)</em>
            </p>
        }
    </div>

    <div class="flex-container">
        <TextBox Value="@SelectedIdString" ReadOnly />

        <Button Size="@ButtonSize.Small"
                Text="@string.Format(Localization.PingPage.LoadSomething, Localization.PingPage.Ping)"
                OnClick="@RequestSelected" />

        <Button Size="@ButtonSize.Small"
                Text="@string.Format(Localization.PingPage.LoadSomething, CommonVocabulary.All)"
                OnClick="@RequestAll" />
    </div>

    <div class="flex-container">
        <SpinEdit Value="@CreateCommandDelayMs"
                  Interval="1"
                  Minimum="10"
                  Maximum="@int.MaxValue" />

        <Button Size="@ButtonSize.Small"
                Text="@string.Format(UserActions.GenerateSomething, Localization.PingPage.PingDelayed)"
                OnClick="@CreateDelayed" />

        <Button Size="@ButtonSize.Small"
                Text="@string.Format(UserActions.GenerateSomething, Localization.PingPage.Ping)"
                OnClick="@Create" />
    </div>

    <div class="flex-container">
        <label>@Localization.PingPage.ConsumeException</label>
        <CheckBox @bind-Value="ThrowOnConsume" />

        <label>@Localization.PingPage.ThrowOnRetry</label>
        <CheckBox @bind-Value="ThrowOnRetry" />
    </div>

    <div class="flex-container">
        <label>@Localization.PingPage.LastActivity</label>
        <div>@LastActivity</div>
    </div>

    <div class="flex-container">
        <label>@Localization.PingPage.ControllerApi</label>
        <div><a href="/api/ping" target="_blank">@Localization.PingPage.ApiGetPings</a></div>
    </div>

    @if (PingState.StoredPings == null)
    {
        <p>
            <em>@Localization.PingPage.Loading</em>
        </p>
    }
    else
    {
        <Grid Items="_pingsQueryable">
            <ActionButtons>
                <DeleteGridActionButton Enabled="_isSinglePingSelected"
                                        OnClick="Delete" />
            </ActionButtons>

            <ChildContent>
                <ItemSelectColumn KeySelector="@(item => item.Id)" Selection="@PingGridItemSelection" />
                <PropertyColumn Property="@(item => item.Id)" />
                <PropertyColumn Property="@(item => item.RequestId)" />
                <PropertyColumn Property="@(item => item.Created)" />
                <TemplateColumn Title="@Localization.PingPage.Api">
                    <a href=@("/api/ping/" + context.Id.ToString()) target="_blank">@string.Format(UserActions.GetSomething, Localization.PingPage.Ping)</a>
                </TemplateColumn>
            </ChildContent>
        </Grid>
    }

</div>

<Dialog HeaderText="@CommonPhrases.AnErrorOccurred"
        @bind-Visible="@ShowDialog"
        Height="35%"
        Width="35%">

    <Body>
        <DialogBodyTextLayout>
            @LastError
        </DialogBodyTextLayout>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@(() => ShowDialog = false)"
                            Text="@CommonVocabulary.Ok" />
    </Footer>
</Dialog>
