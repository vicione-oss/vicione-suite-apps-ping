@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.ComboBox
@using ViciOne.Ui.Blazor.Components.LoadingSpinner.Components

@inherits ModulePageBase<PingClientModule>

<div class="builder-container">
    <div class="builder-toolbar">
        <span>Available Components</span>
        <ComboBox Items="@Model.ComponentList"
                  @bind-Value="@Model.Component"
                  ValueSelector="@(item => item.Value)"
                  TextSelector="@(item => item.Text)"></ComboBox>

        <Button Text="Render"
                OnClick="@(() => RenderComponent(Model.Component))"
                Size="ButtonSize.Small"></Button>

        <Button Text="Clear"
                OnClick="ClearComponent"
                Size="ButtonSize.Small"></Button>
    </div>

    <div class="builder-content">
        @if (Model.IsLoading)
        {
            <LoadingSpinner Visible="true" />
        }
        else
        {
            @Child
        }
    </div>

</div>
